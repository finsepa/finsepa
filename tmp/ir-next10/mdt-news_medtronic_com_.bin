<script type="text/javascript" src="js/wd_resize.js" wd_script_id="wd_resize.js" nonce="NzdkZDQyZWViNDI3OTUzZGQzZTNiNWJlMmFiODBjZjY0YTUzNGFjZg=="></script>
<link href="css/wd_modal.css" type="text/css" rel="stylesheet" wd_script_id="wd_modal.css">
