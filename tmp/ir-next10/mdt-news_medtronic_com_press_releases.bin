<script type="text/javascript" wd_script_id="item_search_form_script" nonce="YjdhNDA4MjIxZmMxZGQ5NDc3MWNjNjI0ZWE3YzVlZjY1YzgzMWIzZg==">
			function wd_item_search_form_toggle(link, advanced) {
				var $ = webDriver.jQuery;
				var $container = $(link).closest(".wd_item_search_form_container");
				var $basic_form = $container.find(".wd_search_form_basic");
				var $advanced_form = $container.find(".wd_search_form_advanced");
				var $target_form = advanced ? $advanced_form : $basic_form;

				var $basic_inputs = $basic_form.find(":input");
				$basic_inputs.each(function() {
					var $advanced_input = $advanced_form.find(this.tagName+'[name="'+this.name+'"]');
					if ($advanced_input.length > 0) {
						if (advanced)
							$advanced_input.val($(this).val());
						else
							$(this).val($advanced_input.val());
					}
				});

				$basic_form.toggle(!advanced);
				$advanced_form.toggle(advanced);

				var $focus_target = $target_form.find("input[name=\"keywords\"]").filter(":visible:not(:disabled)").first();
				if ($focus_target.length === 0)
					$focus_target = $target_form.find(":input").filter(":visible:not(:disabled)").first();
				var focus_target = $focus_target.length > 0 ? $focus_target.get(0) : null;
				if (focus_target)
					setTimeout(function() { focus_target.focus(); }, 0);
			}

			function wd_item_search_form_highlight(form) {
				var $btn = $(form).find('input[type="submit"],button[type="submit"]');
				$btn.addClass("wd_highlight");
			}

			function wd_item_search_form_submit(form, in_submit) {
				var $form = $(form);

				var have_url = false;
				$form.find("select").each(function() {
					var $select = $(this);
					
					if (!$select.val())
						$select.prop("disabled", "disabled");

					var url = $select.find("option:selected").attr("wd_url");
					if (url && !have_url) {
						$form.attr("action", url);
						$select.prop("disabled", "disabled");
						$form.find('input[name="s"]').prop("disabled", "disabled");
						have_url = true;
					}
				});

				$form.find("input").each(function() {
					var $input = $(this);
					
					if (!$input.val())
						$input.prop("disabled", "disabled");
				});

				if (!in_submit)
					$form.submit();
			}
		</script>
